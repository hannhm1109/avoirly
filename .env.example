# Set these in your shell. This file is documentation, not loaded automatically.
OPENAI_API_KEY=
# Explicitly choose a model supporting Chat Completions, vision, PDFs and Structured Outputs.
OPENAI_MODEL=

# Local development defaults. Hosted values are documented in docs/CONFIGURE.md.
AVOIRLY_MODE=local
DATABASE_URL=postgresql+psycopg://avoirly:local-avoirly-only@127.0.0.1:55432/avoirly
AVOIRLY_STORAGE_ROOT=
AVOIRLY_LOCAL_OWNER_ID=11111111-1111-4111-8111-111111111111
AVOIRLY_LEASE_SECONDS=120
AVOIRLY_WEB_ORIGIN=http://127.0.0.1:3000
AVOIRLY_DAILY_CASES=20
AVOIRLY_DAILY_ANALYSES=40
AVOIRLY_DAILY_UPLOADS=60
AVOIRLY_DAILY_REVIEWS=120
AVOIRLY_DAILY_TRACKING=120
AVOIRLY_MAX_ATTEMPTS=3

# Real PostgreSQL tests create/drop a random isolated schema in this database.
AVOIRLY_TEST_DATABASE_URL=
